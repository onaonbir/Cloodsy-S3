[Unit]
Description=Cloodsy S3 Server
Documentation=https://github.com/onaonbir/Cloodsy-S3
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloodsys3
Group=cloodsys3
WorkingDirectory=/opt/cloodsys3
# Optional environment overrides (CLOODSYS3_LISTEN, CLOODSYS3_DATA_DIR, ...).
# The leading "-" makes the file optional.
EnvironmentFile=-/etc/cloodsys3/env
ExecStart=/opt/cloodsys3/cloodsys3 serve -config /opt/cloodsys3/config.yaml
Restart=always
RestartSec=5
LimitNOFILE=65535
# Give in-flight uploads time to finish on stop/restart (graceful shutdown).
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077

# --- Security hardening ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native

# ProtectSystem=strict mounts the whole filesystem read-only for the service;
# only the paths below stay writable. The default data directory
# (/opt/cloodsys3/.cloodsys3) is covered by /opt/cloodsys3.
#
# IMPORTANT: every bucket that uses a custom storage directory
# (`cloodsys3 bucket create <name> --storage-dir=/mnt/ssd` or
# `cloodsys3 bucket storage <name> --dir=/mnt/hdd`) lives OUTSIDE this path.
# Add each such directory to ReadWritePaths or the server will fail every
# write to that bucket with a permission error. Do not edit this file in
# place; use a drop-in so package updates never overwrite your change:
#
#   sudo systemctl edit cloodsys3
#
#   [Service]
#   ReadWritePaths=/mnt/ssd
#   ReadWritePaths=/mnt/hdd
#
#   sudo systemctl daemon-reload && sudo systemctl restart cloodsys3
#
# TLS certificates only need to be readable by the cloodsys3 user; they do
# not have to be listed here.
ReadWritePaths=/opt/cloodsys3

[Install]
WantedBy=multi-user.target
